# Sandbox image for the Claude Code CLI agent harness (BENCH_SANDBOX_IMAGE).
#
# One image per harness: a CLI version bump here must not invalidate the A/B
# baselines of the other agents under test, so the images are deliberately not
# a shared multi-stage build with per-agent targets.
#
# Contents are the tools a task may legitimately need inside the boundary. The
# agent's cluster credential, workspace, and fixtures are mounted at run time
# by devops_bench/agents/sandbox.py — never baked in here. Nor is the model
# credential: a keyed provider crosses in the env overlay, and a Vertex-routed
# arm reaches the host-side metadata emulator instead.

FROM node:22-slim

# Versions are pinned so a rebuild reproduces the image an A/B arm was scored
# with; bump them deliberately and re-baseline. The CLI enforces its own model
# floor — a model newer than the pinned CLI is refused with an API 400 naming
# the required version, so this pin is what decides which models the arm can
# run at all.
ARG KUBECTL_VERSION=v1.31.0
ARG HELM_VERSION=v3.16.3
ARG CLAUDE_CODE_VERSION=2.1.270

# Modern Git comes from backports for reftable support; ripgrep and jq are
# what the agent's own search and JSON handling reach for.
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" > /etc/apt/sources.list.d/backports.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        ripgrep \
    && apt-get install -y -t bookworm-backports --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# kubectl and helm: resolve the arch from the build platform rather than
# hardcoding amd64, so the image builds on an arm64 laptop as well as the
# x86 bastion.
RUN arch="$(dpkg --print-architecture)" \
    && curl -fsSLO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" \
    && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl \
    && rm kubectl \
    && curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${arch}.tar.gz" \
        | tar -xz -C /tmp \
    && install -o root -g root -m 0755 "/tmp/linux-${arch}/helm" /usr/local/bin/helm \
    && rm -rf "/tmp/linux-${arch}"

# The npm package rather than the native installer: the latter installs into
# $HOME and rewrites shell profiles, both meaningless in an image whose HOME is
# container-owned and replaced per run. Installed globally so it resolves as
# bare `claude` — inside the boundary the image resolves argv[0], and the
# harness passes the bare name because a host path means nothing here.
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force \
    && claude --version

WORKDIR /workspace
