apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: shop
  namespace: ${namespace}
  labels:
    living-stack: ${system}
    living-stack-component: orders-db
spec:
  instances: ${instances}
  # Restart-required settings roll through a replica promotion so the write
  # service stays available and logical replication can reconnect cleanly.
  primaryUpdateMethod: switchover
  imageName: ${postgres_image}
  enableSuperuserAccess: true
  inheritedMetadata:
    labels:
      living-stack: ${system}
      living-stack-component: orders-db
  postgresql:
    parameters:
      max_connections: "20"
      wal_level: logical
      max_replication_slots: "10"
      max_wal_senders: "10"
    pg_hba:
      - hostssl replication debezium all scram-sha-256
      - hostssl all debezium all scram-sha-256
  bootstrap:
    initdb:
      database: shop
      owner: app
      postInitApplicationSQL:
        - |
          CREATE TABLE customers (
            id SERIAL PRIMARY KEY,
            name TEXT NOT NULL,
            email TEXT NOT NULL UNIQUE,
            tier TEXT NOT NULL DEFAULT 'standard',
            created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
            updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
          );
        - |
          CREATE TABLE products (
            id SERIAL PRIMARY KEY,
            name TEXT NOT NULL,
            category TEXT NOT NULL,
            price NUMERIC(10,2) NOT NULL,
            stock INTEGER NOT NULL DEFAULT 0
          );
        - |
          CREATE TABLE orders (
            id SERIAL PRIMARY KEY,
            customer_id INTEGER NOT NULL REFERENCES customers(id),
            status TEXT NOT NULL DEFAULT 'pending',
            total NUMERIC(10,2) NOT NULL DEFAULT 0,
            created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
            updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
          );
        - CREATE INDEX idx_orders_customer_id ON orders(customer_id);
        - CREATE INDEX idx_orders_status ON orders(status);
        - |
          CREATE TABLE order_items (
            id SERIAL PRIMARY KEY,
            order_id INTEGER NOT NULL REFERENCES orders(id),
            product_id INTEGER NOT NULL REFERENCES products(id),
            qty INTEGER NOT NULL,
            unit_price NUMERIC(10,2) NOT NULL
          );
        - CREATE INDEX idx_order_items_order_id ON order_items(order_id);
        - CREATE INDEX idx_order_items_product_id ON order_items(product_id);
        - CREATE PUBLICATION cdc_publication FOR TABLE customers, products, orders, order_items;
        - ALTER TABLE customers REPLICA IDENTITY FULL;
        - ALTER TABLE products REPLICA IDENTITY FULL;
        - ALTER TABLE orders REPLICA IDENTITY FULL;
        - ALTER TABLE order_items REPLICA IDENTITY FULL;
        - GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO app;
        - GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO app;
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      cpu: 500m
      memory: 1Gi
  managed:
    roles:
      - name: debezium
        ensure: present
        login: true
        replication: true
        passwordSecret:
          name: ${debezium_password_secret_name}
